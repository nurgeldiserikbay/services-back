NODE_ENV=development
PORT=3001
HOST=127.0.0.1
# For browser calls, configure an explicit comma-separated allowlist.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set only after provisioning a Kazakhstan-compliant database/processing boundary.
# DATABASE_URL=postgresql://...

# Public search requires a PostgreSQL database initialized from reviewed Services schema.
# All customer/contact data, telemetry and backups must follow country residency policy.
DATABASE_URL=

# Guest cancellation: default OFF. Do not enable without reviewed private TLS
# ingress, browser BFF session/CSRF signer, body limits and staging acceptance.
SERVICES_ENABLE_GUEST_CANCEL_HTTP=disabled
# Independent canonical base64 32-byte secret, never expose to browser.
# GUEST_CANCEL_BFF_HMAC_KEY=
# GUEST_CANCEL_LEDGER_HMAC_KEY=
