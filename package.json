{
  "name": "@services/backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:baseline:generate": "node scripts/generate-baseline.mjs",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:smoke": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f prisma/smoke.sql",
    "db:seed:geo": "tsx scripts/seed-geography.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "pg": "^8.16.3",
    "@prisma/client": "6.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@types/pg": "^8.15.5",
    "prisma": "6.19.0"
  }
}
