# STAGING TEMPLATE ONLY — never installed or enabled by CI.
# Deploy exclusively on an operator-approved Kazakhstan-resident host.
[Unit]
Description=Services IN_APP notification batch (one invocation, no external messages)
Documentation=https://github.com/nurgeldiserikbay/services-back/blob/main/docs/in-app-worker-staging-runbook.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=services-worker
Group=services-worker
WorkingDirectory=/srv/services-back
EnvironmentFile=/etc/services/in-app-worker.env
ExecStart=/usr/bin/npm run worker:in-app:once
TimeoutStartSec=90
Restart=no
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
